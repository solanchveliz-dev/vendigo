APP_ENV=dev
PORT=8080
DATABASE_URL=postgres://vendigo:vendigo@localhost:5432/vendigo?sslmode=disable
WEB_URL=http://localhost:3000

JWT_SECRET=cambia-este-secreto
JWT_ACCESS_MIN=15
JWT_REFRESH_DIAS=30

# 32 bytes en base64. Generar con: openssl rand -base64 32
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# MinIO local (docker compose). En AWS se deja S3_ENDPOINT vacío y se usa el rol IAM.
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=vendigo
S3_SECRET_KEY=vendigo123
S3_BUCKET_PUBLICO=vendigo-publico
S3_BUCKET_PRIVADO=vendigo-privado
MEDIA_PUBLIC_URL=http://localhost:9000/vendigo-publico

# log: el código OTP se muestra en la consola de la API (pruebas). sms: se envía con Amazon SNS.
OTP_CANAL=log

# simulado: respuestas de ejemplo sin costo. bedrock: Amazon Bedrock (requiere permisos IAM).
IA_PROVEEDOR=simulado
IA_MODELO=amazon.nova-lite-v1:0
IA_REGION=us-east-1

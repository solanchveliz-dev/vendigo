# Copia este archivo como deploy/.env EN EL SERVIDOR y complétalo. Nunca subas deploy/.env a GitHub.

# Dominio público. Sin dominio propio sirve sslip.io con la IP elástica: 3-90-12-34.sslip.io
DOMINIO=3-90-12-34.sslip.io
WEB_URL=https://3-90-12-34.sslip.io

APP_ENV=produccion
# 1 = muestra el panel que simula al comprador (solo para la demostración de la tesis). 0 en uso real.
DEMO_COMPRADOR=1

# Amazon RDS (PostgreSQL 16). sslmode=require cifra la conexión.
DATABASE_URL=postgres://vendigo:CLAVE_RDS@vendigo-db.xxxxxx.us-east-1.rds.amazonaws.com:5432/vendigo?sslmode=require

# Genera cada secreto con: openssl rand -base64 48   (la llave de cifrado: openssl rand -base64 32)
JWT_SECRET=
ENCRYPTION_KEY=

# Amazon S3 (sin llaves: usa el rol de la instancia)
S3_REGION=us-east-1
S3_BUCKET_PUBLICO=vendigo-publico-tuapellido
S3_BUCKET_PRIVADO=vendigo-privado-tuapellido
MEDIA_PUBLIC_URL=https://vendigo-publico-tuapellido.s3.us-east-1.amazonaws.com

# SMS con Amazon SNS: sms = envía de verdad; log = solo los escribe en el registro
OTP_CANAL=sms

# IA con Amazon Bedrock: bedrock o simulado
IA_PROVEEDOR=bedrock
IA_MODELO=amazon.nova-lite-v1:0
IA_REGION=us-east-1

# Culqi (llaves de integración "pk_test_" / "sk_test_" mientras sea demostración)
CULQI_LLAVE_PUBLICA=
CULQI_LLAVE_SECRETA=
